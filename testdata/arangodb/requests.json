   "method": "POST",
   "path": "/_db/dbmeta/_api/cursor",
   "header": {
    "Content-Type": [
     "application/json"
    ]
   },
   "body": {
    "query": "FOR u IN types FILTER u._key == 'nothere' UPDATE u WITH {x: 1} IN types"
   }
  },
  {
   "item": 3,
   "name": "every type of a value",
   "method": "POST",
   "path": "/_db/dbmeta/_api/cursor",
   "header": {
    "Content-Type": [
     "application/json"
    ]
   },
   "body": {
    "query": "RETURN {nil: null, t: true, f: false, zero: 0, neg: -1, imax: 9223372036854775807, imin: -9223372036854775808, big: 18446744073709551615, twoTo53: 9007199254740993, twoTo60: 1152921504606846976, half: 1.5, max: 1.7976931348623157e308, tiny: 5e-324, s: 'é 日本 🙂', empty: '', arr: [], obj: {}, date: DATE_ISO8601(0), now: DATE_NOW()}"
   }
  },
  {
   "item": 3,
   "name": "a division by zero",
   "method": "POST",
   "path": "/_db/dbmeta/_api/cursor",
   "header": {
    "Content-Type": [
     "application/json"
    ]
   },
   "body": {
    "query": "RETURN 1 / 0"
