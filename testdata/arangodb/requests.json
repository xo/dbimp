   "method": "POST",
   "path": "/_db/dbmeta/_api/cursor",
   "header": {
    "Content-Type": [
     "application/json"
    ]
   },
   "body": {
    "query": "FOR u IN types FILTER u._key == 'c' RETURN {n: u.n, s: u.s}"
   }
  },
  {
   "item": 2,
   "name": "values of several shapes",
   "method": "POST",
   "path": "/_db/dbmeta/_api/cursor",
   "header": {
    "Content-Type": [
     "application/json"
    ]
   },
   "body": {
    "query": "FOR x IN [1, {a: 1}, [2], 's', null] RETURN x"
   }
  },
  {
   "item": 2,
   "name": "a scalar",
   "method": "POST",
   "path": "/_db/dbmeta/_api/cursor",
   "header": {
    "Content-Type": [
     "application/json"
