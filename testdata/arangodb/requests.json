{
 "driver": "arangodb",
 "requests": [
  {
   "item": 1,
   "name": "create the collection types",
   "method": "POST",
   "path": "/_db/dbmeta/_api/collection",
   "header": {
    "Content-Type": [
     "application/json"
    ]
   },
   "body": {
    "name": "types"
   },
   "phase": "setup"
  },
  {
   "item": 1,
   "name": "create the collection big",
   "method": "POST",
   "path": "/_db/dbmeta/_api/collection",
   "header": {
    "Content-Type": [
     "application/json"
    ]
   },
   "body": {
    "name": "big"
   },
   "phase": "setup"
  },
  {
   "item": 1,
   "name": "create the collection edges",
   "method": "POST",
   "path": "/_db/dbmeta/_api/collection",
   "header": {
    "Content-Type": [
     "application/json"
    ]
   },
   "body": {
    "name": "edges",
    "type": 3
   },
   "phase": "setup"
  },
  {
   "item": 3,
   "name": "insert the documents of every type",
   "method": "POST",
   "path": "/_db/dbmeta/_api/cursor",
   "header": {
    "Content-Type": [
     "application/json"
    ]
   },
   "body": {
    "query": "FOR d IN @docs INSERT d INTO types",
    "bindVars": {
     "docs": [
      {
       "_key": "a",
       "n": 1,
       "s": "text é",
       "b": true,
       "f": 1.5,
       "i": 9223372036854775807,
       "nested": {
        "z": 1,
        "a": [
         1,
         "x"
        ]
       }
      },
      {
       "_key": "b",
       "n": 2,
       "s": "",
       "b": false,
       "f": -2.25,
       "i": -9223372036854775808,
       "none": null
      },
      {
       "_key": "c",
       "n": 3,
       "extra": "only here"
      }
     ]
    }
   },
   "phase": "setup"
  },
  {
   "item": 5,
   "name": "insert 3000 documents",
   "method": "POST",
   "path": "/_db/dbmeta/_api/cursor",
   "header": {
    "Content-Type": [
     "application/json"
    ]
   },
   "body": {
    "query": "FOR i IN 1..3000 INSERT {_key: TO_STRING(i), n: i} INTO big"
   },
   "phase": "setup"
  },
  {
   "item": 3,
   "name": "insert the edges",
   "method": "POST",
   "path": "/_db/dbmeta/_api/cursor",
   "header": {
    "Content-Type": [
     "application/json"
    ]
   },
   "body": {
    "query": "FOR e IN [{_from: 'types/a', _to: 'types/b', w: 1}, {_from: 'types/b', _to: 'types/c', w: 2}] INSERT e INTO edges"
   },
   "phase": "setup"
  },
  {
   "item": 1,
   "name": "the version",
   "method": "GET",
   "path": "/_db/dbmeta/_api/version"
  },
  {
   "item": 1,
   "name": "the version of _system",
   "method": "GET",
   "path": "/_api/version"
  },
  {
