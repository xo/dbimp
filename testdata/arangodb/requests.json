   "method": "POST",
   "path": "/_db/dbmeta/_api/cursor",
   "header": {
    "Content-Type": [
     "application/json"
    ]
   },
   "body": {
    "query": "RETURN {b: 1, a: 2, c: null}"
   }
  },
  {
   "item": 2,
   "name": "a document",
   "method": "POST",
   "path": "/_db/dbmeta/_api/cursor",
   "header": {
    "Content-Type": [
     "application/json"
    ]
   },
   "body": {
    "query": "FOR u IN types FILTER u._key == 'a' RETURN u"
   }
  },
  {
   "item": 2,
   "name": "documents with different attributes",
   "method": "POST",
   "path": "/_db/dbmeta/_api/cursor",
   "header": {
    "Content-Type": [
     "application/json"
    ]
   },
   "body": {
    "query": "FOR u IN types SORT u.n RETURN u"
   }
  },
  {
   "item": 2,
