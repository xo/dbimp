   "body": {
    "sql": "CREATE OR REPLACE TABLE dbmeta.types (id INT, b BOOLEAN, i8 TINYINT, i16 SMALLINT, i32 INT, i64 BIGINT, u8 UINT8, u16 UINT16, u32 UINT32, u64 UINT64, f FLOAT, d DOUBLE, d38 DECIMAL(38, 10), d76 DECIMAL(76, 20), dt DATE, ts TIMESTAMP, tz TIMESTAMP_TZ, iv INTERVAL, s STRING, bin BINARY, arr ARRAY(INT), m MAP(STRING, INT), tup TUPLE(INT, STRING), v VARIANT, bm BITMAP, vec VECTOR(3), g GEOMETRY, geo GEOGRAPHY)"
   },
   "phase": "setup"
  },
  {
   "item": 1,
   "name": "fill the table of every type",
   "method": "POST",
   "path": "/v1/query",
   "header": {
    "Content-Type": [
     "application/json"
    ]
   },
   "body": {
    "sql": "INSERT INTO dbmeta.types VALUES\n(1, true, -128, -32768, -2147483648, -9223372036854775808, 0, 0, 0, 0, 1.5, 0.1, 1234567890123456789012345678.0123456789, 12345678901234567890123456789012345678901234567890123456.12345678901234567890, '1000-01-01', '1000-01-01 00:00:00.000000', '2026-09-29 12:34:56.123456 +05:30', to_interval('1 day 2 hours 3 microseconds'), '\u00e9''\"\\\\ x', from_hex('00ff'), [1, NULL, 3], {'a': 1, 'b': NULL}, (1, 'x'), parse_json('{\"k\": [1, null, \"s\"], \"n\": 1.5}'), to_bitmap('1,3,5'), [1.5, -2, 3], 'POINT(1 2)', 'POINT(3 4)'),\n(2, false, 127, 32767, 2147483647, 9223372036854775807, 255, 65535, 4294967295, 18446744073709551615, -3.4e38, 1.7976931348623157e308, -9999999999999999999999999999.9999999999, -99999999999999999999999999999999999999999999999999999999.99999999999999999999, '9999-12-31', '9999-12-30 21:59:59.999999', '1970-01-01 00:00:00 +00:00', to_interval('-1 month'), '', from_hex(''), [], {}, (0, ''), parse_json('[]'), to_bitmap('0'), [0, 0, 0], 'LINESTRING(0 0, 1 1)', 'POINT(0 0)'),\n(3, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, parse_json('null'), NULL, NULL, NULL, NULL)"
   },
   "phase": "setup"
  },
