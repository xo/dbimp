{
  "driver": "couchbase",
  "requests": [
    {"item": 1, "name": "a statement in a JSON body", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT 1 AS a"}},
    {"item": 1, "name": "a statement in the query of a GET", "method": "GET", "path": "/query/service?statement=SELECT%201%20AS%20a"},
    {"item": 1, "name": "a DML statement", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "UPSERT INTO dbmeta (KEY, VALUE) VALUES (\"dbimp::probe\", {\"x\": 1, \"y\": null})"}},

    {"item": 1, "name": "a write refused by readonly", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "UPSERT INTO dbmeta (KEY, VALUE) VALUES (\"dbimp::readonly\", {})", "readonly": true}},
    {"item": 1, "name": "a response with no metrics", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT 1 AS a", "metrics": false}},
    {"item": 1, "name": "a collection named through query_context", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT RAW COUNT(*) FROM _default", "query_context": "default:dbmeta._default"}},

    {"item": 2, "name": "the columns follow the projection", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT 2 AS b, 1 AS a, 3 AS c"}},
    {"item": 2, "name": "SELECT RAW is one column", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT RAW a FROM ARRAY_RANGE(0, 3) AS a"}},
    {"item": 2, "name": "SELECT * over a document", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT * FROM dbmeta USE KEYS \"dbimp::probe\""}},

    {"item": 3, "name": "every kind of value", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT 1 AS i, -1.5 AS f, \"s\" AS s, true AS b, null AS n, MISSING AS m, [1, 2] AS a, {\"x\": 1} AS o, 9007199254740993 AS big, 9223372036854775807 AS maxint, 123456789012345678901234567890 AS huge, 0.1 AS tenth, \"\" AS e, \"2026-09-27T07:06:47.658Z\" AS t, BASE64_ENCODE(\"x\") AS bin, \"663ca2de-2148-49f5-8763-80f1dc4fa5fe\" AS u"}},
    {"item": 3, "name": "a missing field and a null field of a document", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT d.x, d.y, d.z FROM dbmeta AS d USE KEYS \"dbimp::probe\""}},

    {"item": 4, "name": "positional parameters as $1 and ?", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT $1 AS a, ? AS b, $2 AS c", "args": [1, "it's \"quoted\""]}},
    {"item": 4, "name": "a named parameter", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT $name AS a, $obj AS b", "$name": "x", "$obj": {"k": [1, null]}}},
    {"item": 4, "name": "a parameter that no placeholder names", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT 1 AS a", "args": [1, 2], "$unused": 3}},
    {"item": 4, "name": "a placeholder with no argument", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT $1 AS a, $name AS b"}},

    {"item": 5, "name": "a result of 20000 rows", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT RAW a FROM ARRAY_RANGE(0, 20000) AS a", "pretty": false}},

    {"item": 6, "name": "a syntax error before any rows", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELEKT 1"}},
    {"item": 6, "name": "an error after some rows", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT RAW CASE WHEN a < 3 THEN a ELSE ABORT(\"boom\") END FROM ARRAY_RANGE(0, 5) AS a"}},

    {"item": 7, "name": "a timeout that the server enforces", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT COUNT(*) AS c FROM ARRAY_RANGE(0, 3000) AS a, ARRAY_RANGE(0, 3000) AS b", "timeout": "50ms"}},
    {"item": 7, "name": "a long query that the client leaves after 2 seconds", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT COUNT(*) AS c FROM ARRAY_RANGE(0, 3000) AS a, ARRAY_RANGE(0, 3000) AS b", "client_context_id": "dbimp-disconnect"},
     "timeout": "2s"},
    {"item": 7, "name": "the active requests 1 second after the client left", "method": "GET", "path": "/admin/active_requests",
     "wait": "1s"},
    {"item": 7, "name": "a long query that a statement cancels", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT COUNT(*) AS c FROM ARRAY_RANGE(0, 3000) AS a, ARRAY_RANGE(0, 3000) AS b", "client_context_id": "dbimp-cancel"},
     "background": true},
    {"item": 7, "name": "the statement that cancels it", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "DELETE FROM system:active_requests WHERE clientContextID = \"dbimp-cancel\""},
     "wait": "1s"},
    {"item": 7, "name": "a cancel of a request that does not exist", "method": "DELETE", "path": "/admin/active_requests/00000000-0000-0000-0000-000000000000"},

    {"item": 8, "name": "a wrong password", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT 1 AS a"}, "auth": "wrong"},
    {"item": 8, "name": "a statement that needs a role", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT * FROM system:user_info"}},

    {"item": 9, "name": "the version that usql reads", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT RAW ds_version()"}},

    {"item": 10, "name": "two statements in one request", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT 1 AS a; SELECT 2 AS b"}},
    {"item": 10, "name": "a statement with comments", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "SELECT 1 AS a /* a ? comment */ -- and $1 another\n"}},

    {"item": 11, "name": "BEGIN WORK", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "BEGIN WORK"}},

    {"item": 12, "name": "a request that asks for gzip", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"], "Accept-Encoding": ["gzip"]},
     "body": {"statement": "SELECT RAW a FROM ARRAY_RANGE(0, 1000) AS a"}},
    {"item": 12, "name": "the path without its service", "method": "GET", "path": "/query"},

    {"item": 3, "name": "remove the probe document", "method": "POST", "path": "/query/service",
     "header": {"Content-Type": ["application/json"]},
     "body": {"statement": "DELETE FROM dbmeta USE KEYS \"dbimp::probe\""}}
  ]
}
